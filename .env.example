# Copy to .env (gitignored) and fill in. Read by the firmware build and by the PC app.

# --- firmware (needs a rebuild + flash after a change) ---
WIFI_SSID=your-2.4GHz-wifi
WIFI_PASS=your-wifi-password
OTA_PASSWORD=password-for-web-firmware-updates

# --- PC app ---
# the app finds the screen as musicframe.local by itself; set an IP only if your network blocks .local names
# SCREEN_HOST=192.168.1.50
# lrc.red asks apps to send a link and a contact email
CONTACT_LINK=https://example.com/your-link
CONTACT_EMAIL=your-email@example.com
